# Optional API Keys (TerraPulse works out of the box with zero keys!)

# Google Gemma (Open-Weight Model)
# If left empty, TerraPulse uses local Gemma zero-shot heuristic runtime
GEMMA_API_KEY=
GEMMA_MODEL=gemma-2-9b-it
USE_LOCAL_GEMMA=false
OLLAMA_ENDPOINT=http://localhost:11434/api/generate

# ElevenLabs (Voice Synthesis)
# If left empty, TerraPulse smoothly uses browser high-definition WebSpeech synthesis
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Sentry (Agent Tracing & Observability)
# Enter your Sentry DSN to broadcast live agent traces to Sentry dashboard
SENTRY_DSN=
ENVIRONMENT=development
